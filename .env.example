# Postgres connection string. Vercel Postgres / Neon / Supabase all work —
# create one, then paste its connection string here (and in Vercel's
# Environment Variables settings for the deployed app).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob storage token, for uploaded photos. Only needed when deployed —
# local dev writes straight to /public/uploads and ignores this.
# Create a Blob store in the Vercel dashboard's Storage tab to get one.
BLOB_READ_WRITE_TOKEN=

# Optional — enables AI-written style notes on generated outfits and photo
# classification. Without it the app falls back to local rule-based logic.
ANTHROPIC_API_KEY=your_key_here
